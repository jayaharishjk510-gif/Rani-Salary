rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to get allowed departments based on authenticated email
    function getPermissions() {
      return request.auth.token.email == 'admin@rani.com' 
        ? ['Rani Javuli', 'Rani Readymade', 'New Rani'] 
        : request.auth.token.email == 'javuli@rani.com' 
          ? ['Rani Javuli'] 
          : (request.auth.token.email == 'readymade@rani.com' || request.auth.token.email == 'readymades@rani.com') 
            ? ['Rani Readymade'] 
            : request.auth.token.email == 'newrani@rani.com' 
              ? ['New Rani'] 
              : [];
    }

    // Rules for employees collection
    match /employees/{employeeId} {
      allow read: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || resource.data.dept in getPermissions());
      allow create: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || request.resource.data.dept in getPermissions());
      allow update: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || (resource.data.dept in getPermissions() && request.resource.data.dept in getPermissions()));
      allow delete: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || resource.data.dept in getPermissions());
    }

    // Rules for advances collection
    match /advances/{advanceId} {
      allow read: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || resource.data.dept in getPermissions());
      allow create: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || request.resource.data.dept in getPermissions());
      allow update: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || (resource.data.dept in getPermissions() && request.resource.data.dept in getPermissions()));
      allow delete: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || resource.data.dept in getPermissions());
    }

    // Rules for salary_records collection
    match /salary_records/{recordId} {
      allow read: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || resource.data.dept in getPermissions());
      allow create: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || request.resource.data.dept in getPermissions());
      allow update: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || (resource.data.dept in getPermissions() && request.resource.data.dept in getPermissions()));
      allow delete: if request.auth != null && 
        (request.auth.token.email == 'admin@rani.com' || resource.data.dept in getPermissions());
    }
  }
}
